#compdef box-rpg

_box-rpg() {
  local -a commands
  commands=(
    'cleanup:interactively remove launcher-managed data'
    'inspect:inspect a supported game'
    'runtime:manage game runtimes'
    'launch:launch a supported game'
    'config:show or set configuration'
    'diagnose:check launcher setup'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'box-rpg command' commands
    return
  fi

  case "$words[2]" in
    runtime)
      if (( CURRENT == 3 )); then
        _values 'runtime action' list available install remove easyrpg
        return
      fi
      case "$words[3]" in
        available) _arguments '--page[select an online version page]:page:' '--interactive[select and install a version]' '--architecture[use an NW.js architecture]:architecture:' '--sdk[use an NW.js SDK build]' ;;
        install|remove) _arguments '--architecture[use an NW.js architecture]:architecture:' '--sdk[use an NW.js SDK build]' ;;
        easyrpg)
          if (( CURRENT == 4 )); then
            _values 'EasyRPG action' list available install remove
            return
          fi
          case "$words[4]" in
            available) _arguments '--page[select an online version page]:page:' '--interactive[select and install a version]' ;;
          esac
          ;;
      esac
      ;;
    config) _values 'config command' show set ;;
    launch) _arguments '--runtime[use an NW.js version]:version:' '--sdk[use an NW.js SDK build]' '--game-cwd[use the game root as the NW.js working directory]' '--copy-root-file[copy a direct game-root file into the isolated session]:file:' ;;
    diagnose) _arguments '--runtime[use an NW.js version]:version:' '--sdk[use an NW.js SDK build]' ;;
  esac
}

_box-rpg "$@"
