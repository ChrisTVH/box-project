#compdef box-rpg

_box-rpg() {
  local -a commands
  commands=(
    'cleanup:remove launcher-managed data'
    'inspect:inspect a supported game'
    'runtime:manage game runtimes'
    'launch:launch a supported game'
    'config:show or set configuration'
    'diagnose:check launcher setup'
  )

  if (( CURRENT == 2 )); then
    _arguments '--help[show help]' '--version[show the program version]' "1:box-rpg command:(${commands[@]%%:*})"
    return
  fi

  case "$words[2]" in
    runtime)
      if (( CURRENT == 3 )); then
        _values 'runtime provider' 'nwjs:manage NW.js runtimes' 'easyrpg:manage EasyRPG Player runtimes'
        return
      fi
      case "$words[3]" in
        nwjs)
          if (( CURRENT == 4 )); then
            _values 'NW.js action' list available install remove
            return
          fi
          case "$words[4]" in
             available) _arguments '--help[show help]' '--page[select an online version page]:page:' '--interactive[select and install a version]' '--architecture[use an NW.js architecture]:architecture:' '--sdk[use an NW.js SDK build]' ;;
             install|remove) _arguments '--help[show help]' '--architecture[use an NW.js architecture]:architecture:' '--sdk[use an NW.js SDK build]' ;;
             list) _arguments '--help[show help]' ;;
          esac
          ;;
        easyrpg)
          if (( CURRENT == 4 )); then
            _values 'EasyRPG action' list available install remove
            return
          fi
          case "$words[4]" in
             available) _arguments '--help[show help]' '--page[select an online version page]:page:' '--interactive[select and install a version]' ;;
             list|install|remove) _arguments '--help[show help]' ;;
          esac
          ;;
      esac
      ;;
    cleanup)
      if (( CURRENT == 3 )); then
        _values 'cleanup action' all list remove '--yes[delete immediately without prompting]' '--interactive[open the interactive cleanup menu]'
        return
      fi
      case "$words[3]" in
        all) _arguments '--help[show help]' '--yes[delete immediately without prompting]' ;;
        list)
          if (( CURRENT == 4 )); then
            _values 'cleanup category' roots runtimes downloads profiles
          else
            _arguments '--help[show help]'
          fi
          ;;
        remove)
          if (( CURRENT == 4 )); then
            _values 'cleanup category' roots runtimes downloads profiles
          elif [[ "$words[4]" == roots || "$words[4]" == runtimes || "$words[4]" == downloads || "$words[4]" == profiles ]]; then
            _arguments '--all[remove every item in the category]' '--yes[delete immediately without prompting]' '--help[show help]'
          elif [[ -n "$words[4]" && "$words[4]" != "--all" ]]; then
            _arguments '--yes[delete immediately without prompting]'
          else
            _arguments '--all[remove every item in the category]' '--yes[delete immediately without prompting]'
          fi
          ;;
        --interactive) _arguments '--help[show help]' ;;
        --yes) _values 'cleanup action' all list remove ;;
      esac
      ;;
    inspect) _arguments '--help[show help]' '1:game path:_files -/' ;;
    config) _arguments '--help[show help]' '1:config command:(show set)' ;;
    launch) _arguments '--help[show help]' '--runtime[use an NW.js version]:version:' '--sdk[use an NW.js SDK build]' '--copy-root-file[copy a direct game-root file into the isolated session]:file:' ;;
    diagnose) _arguments '--help[show help]' '--runtime[use an NW.js version]:version:' '--sdk[use an NW.js SDK build]' ;;
  esac
}

_box-rpg "$@"
