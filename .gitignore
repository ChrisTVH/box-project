*

!*/
!*.gitignore
!*.gitkeep

!docs/**/*.md
!/*.md

!/LICENSE

# Python project files
!/*.py
!/*.toml
!/*.lock

# CI pipelines (manual AppImage distribution builds)
!/.github/workflows/*.yml
!/.gitlab-ci.yml

# Ignore build artifacts (even though whitelisted above)
/__pycache__/
/src/**/__pycache__/
/tests/**/__pycache__/
*.pyc
*.egg-info/
/dist/
/tools/target/
/build/
/.pytest_cache/
/.ruff_cache/
/.venv/
/.venv-gui/
/venv/
